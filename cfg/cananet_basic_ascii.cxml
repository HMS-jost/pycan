        <udef_brpD_1>2</udef_brpD_1>
        <udef_sjwD_1>1</udef_sjwD_1>
        <udef_tseg1D_1>7</udef_tseg1D_1>
        <udef_tseg2D_1>2</udef_tseg2D_1>
        <udef_tdo_1>15</udef_tdo_1>
        <udef_baudD_1></udef_baudD_1>
        <udef_spointD_1></udef_spointD_1>
