<?xml version="1.0" encoding="UTF-8" ?>
<CanBgiConfig>
    <select>
        <author></author>
        <cfg_name></cfg_name>
        <add_info></add_info>
        <conf_type>ASCII Gateway Mode</conf_type>
        <dev_type>CAN@net NT 420</dev_type>
        <version>13</version>
    </select>
    <interface>
        <line_ending>\n</line_ending>
        <protocol>TCP</protocol>
        <ip_port1>19228</ip_port1>
        <ip_port2>19229</ip_port2>
        <ip_port3>19240</ip_port3>
        <serial_box>False</serial_box>
        <serial_no></serial_no>
        <expert_mode_box>False</expert_mode_box>
        <expert_mode>maximum throughput (default)</expert_mode>
        <data_loss>discard new messages (default)</data_loss>
    </interface>
    <master>
        <basis>
            <ipaddr>0.0.0.0</ipaddr>
            <ip_port>19239</ip_port>
